# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. NEVER commit a real key.
#
# SECURITY WARNING: EXPO_PUBLIC_* variables are embedded in the app bundle.
# Anyone with the app binary can extract this key. This is acceptable ONLY for
# a private educational prototype. Before any public release, move AI calls
# behind a backend you control.

EXPO_PUBLIC_OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Must be a free model (id ending in ":free"). Fallbacks are tried on 404/429.
EXPO_PUBLIC_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
EXPO_PUBLIC_OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free

# --- Narration (optional, Version 2) ---
# Device speech is free and needs no configuration.
# Free realistic voices: run the local Piper server on your PC (see tools/tts-server/README.md)
# and put its LAN address here. This is not a secret.
EXPO_PUBLIC_TTS_SERVER_URL=
# NEVER put an ElevenLabs (or any) API key in an EXPO_PUBLIC_* variable.

# --- AI scene video (optional, Version 4) ---
# Free local image-to-video on your own NVIDIA GPU (see tools/video-server/README.md).
# Put the PC's LAN address here, e.g. http://192.168.1.20:5003. Not a secret.
# The server only answers home-network clients: never port-forward it.
EXPO_PUBLIC_VIDEO_SERVER_URL=
